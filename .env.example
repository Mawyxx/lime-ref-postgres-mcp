# LIME agent identity (MCP OAuth JWT — not site-login AIT)
LIME_EXPECTED_DOMAIN=your-corporate-domain.com
LIME_JWKS_URL=https://lime.pics/.well-known/jwks.json
LIME_EXPECTED_AUD=mcp
LIME_JWKS_CACHE_TTL_SECONDS=3600
LIME_JWT_VERIFY_LEEWAY_SECONDS=120
AGENTS_POLICY_PATH=./config/agents.json
# Policy reload: lazy mtime check every POLICY_RELOAD_TTL_SECONDS (soft-keep last good on bad reload)
POLICY_RELOAD_TTL_SECONDS=60

# Service DB credentials (NOT the agent passport) — AsyncpgDatabaseGateway (P4, lazy pool)
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname
PG_STATEMENT_TIMEOUT=5s
PG_LOCK_TIMEOUT=2s
PG_IDLE_IN_TRANSACTION_TIMEOUT=10s
PG_MAX_RESULT_BYTES=1048576
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=4

# Optional: demo agent-action cards (EventBus ConsoleSink) — not process logs
ENABLE_CONSOLE_EVENT_SINK=1

# Process observability — ADR-003 / PRD §8 (separate from ConsoleSink §7)
LIME_MCP_LOG_LEVEL=INFO
LIME_MCP_LOG_FORMAT=json
# LIME_MCP_LOG_STREAM=stderr
# LIME_MCP_METRICS=1

# MCP Streamable HTTP serve (uv run python -m lime_ref_postgres_mcp serve)
LIME_MCP_BIND_HOST=127.0.0.1
LIME_MCP_PORT=8000
